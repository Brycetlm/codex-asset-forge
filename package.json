{
  "name": "codex-asset-forge",
  "productName": "UI Forge",
  "description": "Local-first Codex CLI studio for production-ready 2D game assets",
  "author": "UI Forge",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "audit:public": "node scripts/check-public-repo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "app:dev": "npm run build && electron .",
    "app:build": "npm run build && electron-builder --mac dir --arm64 && codesign --force --deep --sign - 'release/mac-arm64/UI Forge.app'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.uiforge.studio",
    "productName": "UI Forge",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "starter/data"
      },
      {
        "from": "outputs",
        "to": "starter/outputs"
      },
      {
        "from": "library/imports",
        "to": "starter/library/imports"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ]
    }
  }
}
